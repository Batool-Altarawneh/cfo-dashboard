# .dockerignore
# This file tells Docker which files and folders should NOT be copied into the Docker image when we run: docker build

# Virtual environment
# Do not copy the local Python environment into Docker.
# Docker will create its own environment and install packages from requirements.txt.
venv/

# Git files
# Git history is useful for development, but it is not needed inside the Docker image.
# Excluding it keeps the image smaller.
.git/
.gitignore

# Environment variables
# .env may contain passwords, database credentials, API keys, or secrets.
# Secrets should never be copied into a Docker image.
.env

# Power BI files
# Power BI reports are not needed for running the Streamlit app.
# The Docker image should only contain what the app needs at runtime.
powerbi/

# Raw data files
# Raw files are not needed inside the image if the app reads cleaned data or connects to PostgreSQL at runtime.
data/raw/

# Python cache files
# These files are automatically generated by Python and are not needed.
__pycache__/
*.pyc
*.pyo
*.pyd

# Test cache and coverage reports
# These are created when running tests locally and are not needed in production.
.pytest_cache/
htmlcov/

# Editor and IDE settings
# These are personal settings from VS Code, PyCharm, Vim, etc.
# They should not be part of the Docker image.
.vscode/
.idea/
*.swp